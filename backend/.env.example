# ── CrimeSense AI — Backend Environment ────────────────────────────────
# Copy to .env and fill in real values.

# App
PROJECT_NAME="CrimeSense AI"
ENVIRONMENT=development           # development | staging | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database — PostgreSQL + PostGIS
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://crimesense:crimesense@localhost:5432/crimesense
POSTGRES_USER=crimesense
POSTGRES_PASSWORD=crimesense
POSTGRES_DB=crimesense
# Enable PostGIS geometry columns. Leave false to run on stock PostgreSQL
# (no feature loss — map/hotspot queries use lat/lon floats). Set true only
# on a PostGIS-enabled database.
USE_POSTGIS=false

# Security — JWT
SECRET_KEY=CHANGE_ME_use_a_long_random_string_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# AI — GROQ (model must be one your key can access: GET https://api.groq.com/openai/v1/models)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# OCR — PyTesseract
# Path to the tesseract binary (Windows example shown). Leave blank if on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Path to poppler bin (Windows) for PDF->image conversion. Leave blank if on PATH.
POPPLER_PATH=

# Seed / data  (generate with: python -m app.scripts.generate_nagpur_data)
DATA_CACHE_PATH=../data/nagpur_crime_cache.json
SEED_SAMPLE_SIZE=8000

# Case files / evidence attachments (stored on disk, relative to backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
